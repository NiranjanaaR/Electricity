DATABASE_URL=postgresql+psycopg2://obxai:obxai@localhost:5432/obxai
ANALYSIS_LOOKBACK_DAYS=180
SCHEDULE_HOUR=7
SCHEDULE_MINUTE=0
TIMEZONE=Europe/Oslo
ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional — enables the "Ask AI" panel on each stock page. Without it the
# panel shows a friendly "configure a key" message and nothing else.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
